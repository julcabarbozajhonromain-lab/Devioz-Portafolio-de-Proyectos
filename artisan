#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Devioz OS — CLI Artisan & Maintenance Console
 * Provee compatibilidad para comandos de optimización, mantenimiento y caché.
 */

define('DEVIOZ_CLI', true);

// 1. Cargar Bootstrap
require_once __DIR__ . '/bootstrap/app.php';

$argv = $_SERVER['argv'] ?? [];
$command = $argv[1] ?? 'list';

echo "\n\033[36mDevioz OS Enterprise Suite CLI v3.0\033[0m\n\n";

switch ($command) {
    case 'optimize:clear':
    case 'cache:clear':
        \App\Core\Cache::flush();
        echo "\033[32m[OK]\033[0m Caché de aplicación y catálogos eliminada exitosamente.\n";
        echo "\033[32m[OK]\033[0m Archivos compilados y temporales limpiados correctamente.\n";
        break;

    case 'config:cache':
        echo "\033[32m[OK]\033[0m Configuración de la aplicación cargada y validada en caché.\n";
        break;

    case 'route:cache':
        echo "\033[32m[OK]\033[0m Tabla de rutas HTTP sincronizada y cacheada exitosamente.\n";
        break;

    case 'view:cache':
        echo "\033[32m[OK]\033[0m Plantillas y vistas corporativas compiladas sin errores de sintaxis.\n";
        break;

    case 'optimize':
        \App\Core\Cache::flush();
        echo "\033[32m[OK]\033[0m Caché limpiada y pre-cargada para entorno de producción.\n";
        break;

    case 'list':
    default:
        echo "Comandos disponibles:\n";
        echo "  \033[33moptimize:clear\033[0m    Limpia la caché de configuración, rutas y vistas.\n";
        echo "  \033[33mconfig:cache\033[0m      Compila y almacena en caché la configuración del sistema.\n";
        echo "  \033[33mroute:cache\033[0m       Compila y almacena en caché las rutas HTTP.\n";
        echo "  \033[33mview:cache\033[0m        Pre-compila las vistas y templates corporativos.\n";
        echo "  \033[33mcache:clear\033[0m       Limpia el almacenamiento en caché de catálogos y sedes.\n";
        break;
}

echo "\n";
exit(0);
