APP_NAME="Devioz OS"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/Devioz-Portafolio-de-Proyectos/public
APP_TIMEZONE=America/Lima

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=devioz_classic
DB_USERNAME=root
DB_PASSWORD=

UPLOAD_MAX_SIZE=524288000
UPLOAD_ALLOWED_TYPES=pdf,zip,doc,docx,xls,xlsx,ppt,pptx,jpg,jpeg,png,webp,gif

# Configuración Dual de Inteligencia Artificial para LABVA (Fallback de Alta Disponibilidad)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
